 		;;
 	tplink,deco-m4r-v1|\
-	tplink,deco-p9-v1v2|\
 	tplink,deco-s4-v2)
 		ucidef_add_switch "switch0" \
 			"0@eth0" "3:lan:1" "5:lan:2"
 		;;
+	tplink,deco-p9-v1v2)
+		# port 2 : puce CPL (voir package plc-bcm)
+		ucidef_add_switch "switch0" \
+			"0@eth0" "3:lan:1" "5:lan:2" "2:lan:3"
+		;;
 	tplink,eap225-wall-v2)
 		ucidef_add_switch "switch0" \
 			"0@eth0" "1:lan" "2:lan" "3:lan" "4:lan"
