From 8d42ee7d60647c5b6997847e62dbe406abd5f318 Mon Sep 17 00:00:00 2001
From: Thomas Dannenmuller <thomas.dannenmuller@opendigitaleducation.com>
Date: Tue, 27 Oct 2026 12:46:31 +0000
Subject: [PATCH 2/3] ath79: add support for TP-Link Deco P9

Add the Deco P9 (QCA9563 + QCA9886/QCA9888). Hardware and flash layout
are the same as the Deco M4R v1, so the dts is a copy of the M4R one.
The powerline (PLC) chip is not used: its switch port is left out of
the default network config. See docs/powerline.md in the openwrt-deco-p9 repo for how to enable it.

SUPPORTED_DEVICES keeps deco-p9-v1v2 so installs made with the
openwrt-deco-m4-v1v2 fork can upgrade without -F.

Claude-Session: https://claude.ai/code/session_01PbQyyR6aNqz2qpD4PjFd8q
Signed-off-by: Thomas Dannenmuller <thomas.dannenmuller@opendigitaleducation.com>
---
 .../ath79/dts/qca9563_tplink_deco-p9-v1v2.dts | 167 ++++++++++++++++++
 .../generic/base-files/etc/board.d/02_network |   1 +
 target/linux/ath79/image/generic-tp-link.mk   |  12 ++
 3 files changed, 180 insertions(+)
 create mode 100644 target/linux/ath79/dts/qca9563_tplink_deco-p9-v1v2.dts

diff --git a/target/linux/ath79/dts/qca9563_tplink_deco-p9-v1v2.dts b/target/linux/ath79/dts/qca9563_tplink_deco-p9-v1v2.dts
new file mode 100644
index 0000000..6a90773
--- /dev/null
+++ b/target/linux/ath79/dts/qca9563_tplink_deco-p9-v1v2.dts
@@ -0,0 +1,167 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+
+#include "qca956x.dtsi"
+
+/ {
+	compatible = "tplink,deco-p9-v1v2", "qca,qca9563";
+	model = "TP-Link Deco P9 v1v2";
+
+	aliases {
+		led-boot = &led_power;
+		led-failsafe = &led_power;
+		led-running = &led_power;
+		led-upgrade = &led_power;
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led_power: power {
+			function = LED_FUNCTION_POWER;
+			color = <LED_COLOR_ID_GREEN>;
+			gpios = <&gpio 7 GPIO_ACTIVE_LOW>;
+			default-state = "on";
+		};
+
+		wlan5g {
+			label = "blue:wlan5g";
+			gpios = <&gpio 9 GPIO_ACTIVE_LOW>;
+			linux,default-trigger = "phy0tpt";
+		};
+	};
+
+
+	keys {
+		compatible = "gpio-keys";
+
+		reset {
+			label = "Reset button";
+			linux,code = <KEY_RESTART>;
+			gpios = <&gpio 2 GPIO_ACTIVE_LOW>;
+			debounce-interval = <60>;
+		};
+	};
+};
+
+&pcie {
+	status = "okay";
+
+	wifi@0,0 {
+		compatible = "qcom,ath10k";
+		reg = <0x0000 0 0 0 0>;
+		nvmem-cells = <&precal_art_5000>, <&macaddr_config_8 (-1)>;
+		nvmem-cell-names = "pre-calibration", "mac-address";
+	};
+};
+
+&mdio0 {
+	status = "okay";
+
+	ethernet-switch@10 {
+		compatible = "qca,ar8327";
+		reg = <0x10>;
+		qca,mib-poll-interval = <500>;
+
+		qca,ar8327-initvals = <
+			0x04 0x00080080 /* PORT0 PAD MODE CTRL */
+			0x7c 0x0000007e /* PORT0_STATUS */
+			>;
+	};
+};
+
+&spi {
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <25000000>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "u-boot";
+				reg = <0x000000 0x080000>;
+				read-only;
+			};
+
+			partition@80000 {
+				compatible = "denx,uimage";
+				label = "firmware";
+				reg = <0x080000 0xe00000>;
+			};
+
+			partition@e80000 {
+				label = "product-info";
+				reg = <0xe80000 0x05000>;
+				read-only;
+			};
+
+			partition@e85000 {
+				label = "config";
+				reg = <0xe85000 0x16b000>;
+				read-only;
+
+				nvmem-layout {
+					compatible = "fixed-layout";
+					#address-cells = <1>;
+					#size-cells = <1>;
+
+					macaddr_config_8: macaddr@8 {
+						compatible = "mac-base";
+						reg = <0x8 0x6>;
+						#nvmem-cell-cells = <1>;
+					};
+				};
+			};
+
+			partition@ff0000 {
+				label = "art";
+				reg = <0xff0000 0x010000>;
+				read-only;
+
+				nvmem-layout {
+					compatible = "fixed-layout";
+					#address-cells = <1>;
+					#size-cells = <1>;
+
+					cal_art_1000: calibration@1000 {
+						reg = <0x1000 0x440>;
+					};
+
+					precal_art_5000: pre-calibration@5000 {
+						reg = <0x5000 0x2f20>;
+					};
+				};
+			};
+		};
+	};
+};
+
+&eth0 {
+	status = "okay";
+
+	phy-mode = "sgmii";
+
+	nvmem-cells = <&macaddr_config_8 0>;
+	nvmem-cell-names = "mac-address";
+
+	fixed-link {
+		speed = <1000>;
+		full-duplex;
+	};
+};
+
+&wmac {
+	status = "okay";
+
+	nvmem-cells = <&macaddr_config_8 0>, <&cal_art_1000>;
+	nvmem-cell-names = "mac-address", "calibration";
+};
diff --git a/target/linux/ath79/generic/base-files/etc/board.d/02_network b/target/linux/ath79/generic/base-files/etc/board.d/02_network
index 98f627a..f67aac8 100644
--- a/target/linux/ath79/generic/base-files/etc/board.d/02_network
+++ b/target/linux/ath79/generic/base-files/etc/board.d/02_network
@@ -531,6 +531,7 @@ ath79_setup_interfaces()
 			"0u@eth1" "3:lan:3" "4:lan:2" "5:lan:1" "6u@eth0" "2:wan:4" "1:wan:5"
 		;;
 	tplink,deco-m4r-v1|\
+	tplink,deco-p9-v1v2|\
 	tplink,deco-s4-v2)
 		ucidef_add_switch "switch0" \
 			"0@eth0" "3:lan:1" "5:lan:2"
diff --git a/target/linux/ath79/image/generic-tp-link.mk b/target/linux/ath79/image/generic-tp-link.mk
index ea449a0..530b41c 100644
--- a/target/linux/ath79/image/generic-tp-link.mk
+++ b/target/linux/ath79/image/generic-tp-link.mk
@@ -525,6 +525,18 @@ define Device/tplink_deco-m4r-v1
 endef
 TARGET_DEVICES += tplink_deco-m4r-v1
 
+define Device/tplink_deco-p9-v1v2
+  $(Device/tplink-safeloader-uimage)
+  SOC := qca9563
+  IMAGE_SIZE := 13824k
+  DEVICE_MODEL := Deco P9
+  DEVICE_VARIANT := v1v2
+  DEVICE_PACKAGES := kmod-ath10k-ct ath10k-firmware-qca9888-ct
+  SUPPORTED_DEVICES += deco-p9-v1v2
+  TPLINK_BOARD_ID := DECO-P9-V1V2
+endef
+TARGET_DEVICES += tplink_deco-p9-v1v2
+
 define Device/tplink_deco-s4-v2
   $(Device/tplink-safeloader-uimage)
   SOC := qca9563
-- 
