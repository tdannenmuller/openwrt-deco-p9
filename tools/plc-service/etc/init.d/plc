#!/bin/sh /etc/rc.common
# Writes the NMK from /etc/config/plc to the Broadcom powerline chip of the Deco P9.

START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh -c '
		for i in $(seq 1 30); do
			[ -d /sys/class/net/eth0.1 ] && break
			sleep 2
		done
		exec /usr/sbin/plc-nmk sync'
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger plc
}
